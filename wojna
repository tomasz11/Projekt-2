				game.punkty_gracz2 = game.punkty_gracz2 + 3;
				game.punkty_gracz1 = game.punkty_gracz1 - 3;
				if (ile_wojen > 1) {
					while (dodawanie_pkt_wojna < ile_wojen) {
						game.punkty_gracz2 = game.punkty_gracz2 + 2;
						game.punkty_gracz1 = game.punkty_gracz1 - 2;
